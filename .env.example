# ============================================================
# Muhit o'zgaruvchilari — namuna
# ============================================================
# Bu faylni `.env` nomi bilan nusxa ko'chiring va qiymatlarni to'ldiring.
# `.env` Git'ga TUSHMAYDI.
#
# Vercel'da esa xuddi shu o'zgaruvchilar loyiha sozlamalarida
# "Environment Variables" bo'limiga qo'yiladi (Production + Preview + Development).

# ------------------------------------------------------------
# Baza — Supabase Postgres
# ------------------------------------------------------------
# Supabase panelida: Project Settings -> Database -> Connection string
#
# DATABASE_URL — sayt ish paytida ishlatadigan ulanish.
#   "Transaction pooler" (port 6543) tanlanadi — serverless uchun shu kerak.
# DIRECT_URL  — migratsiyalar uchun to'g'ridan-to'g'ri ulanish (port 5432).
#   Faqat `prisma migrate` / `prisma db` buyruqlarida ishlatiladi.
DATABASE_URL="postgresql://postgres.<loyiha-ref>:<parol>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<loyiha-ref>:<parol>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Bitta jarayon ochadigan ulanishlar soni (odatda o'zgartirilmaydi)
DATABASE_POOL_MAX=""

# ------------------------------------------------------------
# Supabase — Auth va Storage
# ------------------------------------------------------------
# Supabase panelida: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://<loyiha-ref>.supabase.co"

# Ochiq (publishable / anon) kalit — brauzerga chiqadi, bu normal
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-yoki-publishable-kalit>"

# Maxfiy kalit — RLS'ni chetlab o'tadi. FAQAT serverda!
# Hech qachon NEXT_PUBLIC_ prefiksi bilan qo'yilmaydi va Git'ga tushmaydi.
SUPABASE_SERVICE_ROLE_KEY="<service-role-kalit>"

# Yuklangan rasm/hujjatlar saqlanadigan bucket (Storage bo'limida ochiladi)
SUPABASE_STORAGE_BUCKET="media"

# ------------------------------------------------------------
# Boshlang'ich admin (faqat `npm run db:seed` uchun)
# ------------------------------------------------------------
# Seed shu ma'lumot bilan Supabase Auth'da hisob ochadi va unga ADMIN roli beradi.
ADMIN_EMAIL="admin@orkestrvaxor.uz"
ADMIN_PASSWORD="bu-yerga-kuchli-parol"

# ------------------------------------------------------------
# Sayt
# ------------------------------------------------------------
# Sitemap va mutlaq havolalar uchun asosiy manzil
NEXT_PUBLIC_SITE_URL="https://orkestrvaxor.uz"

# ------------------------------------------------------------
# Pochta xabarnomasi (yangi arizalar haqida)
# ------------------------------------------------------------
# Xat shu Gmail manzilidan yuboriladi
SMTP_USER=

# Google hisobidagi 16 belgili "App password" (oddiy parol EMAS).
# Olish: myaccount.google.com -> Security -> 2-Step Verification (yoqilgan
# bo'lishi shart) -> App passwords -> "Mail" uchun yangi parol yasang.
SMTP_PASS=

# Boshqa pochta xizmati ishlatilsa (ixtiyoriy). Standart: smtp.gmail.com : 465
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Xat boradigan manzil admin paneldagi "Sozlamalar → Xabarnoma pochtasi"
# maydonidan olinadi; u bo'sh bo'lsa xat SMTP_USER ning o'ziga boradi.
