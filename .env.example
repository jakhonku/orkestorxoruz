# ============================================================
# Muhit o'zgaruvchilari — namuna
# ============================================================
# Bu faylni `.env` nomi bilan nusxa ko'chiring va qiymatlarni to'ldiring.
# `.env` fayli Git'ga TUSHMAYDI (maxfiy ma'lumot saqlanadi).
#
# Mahalliy ishlab chiqishda:
#   npm run db:start   -> Postgres'ni ko'taradi (Docker/o'rnatish kerak emas)
#   quyidagi DATABASE_URL o'sha serverga mos keladi:
#   postgresql://orkestr:orkestr@localhost:5433/orkestrvaxor?schema=public

# Ma'lumotlar bazasi
DATABASE_URL="postgresql://foydalanuvchi:parol@localhost:5432/orkestrvaxor?schema=public"

# Migratsiyalar uchun yordamchi baza (odatda bo'sh qoldiriladi)
SHADOW_DATABASE_URL=""

# Admin panel sessiyalarini imzolash kaliti.
# Serverda albatta yangi tasodifiy qiymat qo'ying:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="bu-yerga-tasodifiy-uzun-satr-qoyiladi"

# Admin panelga birinchi kirish uchun.
# `npm run db:seed` shu ma'lumot bilan admin foydalanuvchi yaratadi.
ADMIN_EMAIL="admin@orkestrvaxor.uz"
ADMIN_PASSWORD="bu-yerga-kuchli-parol"

# Saytning asosiy manzili (sitemap va havolalar uchun)
NEXT_PUBLIC_SITE_URL="https://orkestrvaxor.uz"
